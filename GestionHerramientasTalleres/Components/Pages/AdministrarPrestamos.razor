@page "/administrar-prestamos"

@using GestionHerramientasTalleres.Models
@using GestionHerramientasTalleres.Services
@using Microsoft.AspNetCore.Authorization
@using static Microsoft.AspNetCore.Components.Web.RenderMode

@attribute [Authorize(Roles = "Administrador")]
@rendermode InteractiveServer

@inject PrestamoService ServicioPrestamos
@inject ILogger<AdministrarPrestamos> Logger

<PageTitle>Administrar préstamos</PageTitle>

<div class="container-fluid py-4">

    <div class="bg-primary text-white rounded-3 p-4 mb-4">
        <h1 class="h3 text-white">Administrar préstamos</h1>

        <p class="mb-0 text-white">
            Revisa las solicitudes y registra las devoluciones.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-info" role="status">
            @mensaje
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-danger" role="alert">
            @error
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-2 mb-3">

                <h2 class="h5 mb-0">Solicitudes registradas</h2>

                <button type="button"
                        class="btn btn-outline-primary"
                        disabled="@ocupado"
                        @onclick="ActualizarAsync">
                    Actualizar
                </button>
            </div>

            @if (ocupado)
            {
                <p role="status">Procesando...</p>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Solicitud</th>
                            <th>Herramienta</th>
                            <th>Usuario ID</th>
                            <th>Fecha de solicitud UTC</th>
                            <th>Fecha de devolución UTC</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!ocupado && prestamos.Count == 0)
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-secondary py-4">
                                    No hay solicitudes registradas.
                                </td>
                            </tr>
                        }

                        @foreach (var prestamo in prestamos)
                        {
                            <tr @key="prestamo.Id">
                                <td>@prestamo.Id</td>

                                <td>@prestamo.HerramientaCodigo</td>

                                <td class="text-break">
                                    <small>@prestamo.UsuarioId</small>
                                </td>

                                <td>
                                    @prestamo.FechaSolicitud.ToString(
                                        "dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @(prestamo.FechaDevolucion?.ToString(
                                        "dd/MM/yyyy HH:mm") ?? "—")
                                </td>

                                <td>
                                    <span class="@ClaseEstado(prestamo.Estado)">
                                        @prestamo.Estado
                                    </span>
                                </td>

                                <td>
                                    @if (prestamo.Estado ==
                                         EstadoPrestamo.Pendiente)
                                    {
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button"
                                                    class="btn btn-success btn-sm"
                                                    disabled="@ocupado"
                                                    @onclick="() => ProcesarAsync(
                                                        prestamo.Id, true)">
Aprobar
</button>

                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    disabled="@ocupado"
                                                    @onclick="() => ProcesarAsync(
                                                        prestamo.Id, false)">
Rechazar
</button>
                                        </div>
                                    }
                                    else if (prestamo.Estado ==
                                             EstadoPrestamo.Aprobado)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                disabled="@ocupado"
                                                @onclick="() => DevolverAsync(
                                                    prestamo.Id)">
Registrar devolución
</button>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            Procesada
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>

@code {
    private List<Prestamo> prestamos = new();

    private bool ocupado;
    private string mensaje = "";
    private string error = "";

    protected override async Task OnInitializedAsync()
    {
        await ActualizarAsync();
    }

    private async Task ActualizarAsync()
    {
        if (ocupado)
        {
            return;
        }

        ocupado = true;
        mensaje = "";
        error = "";

        try
        {
            prestamos = await ServicioPrestamos
                .ObtenerTodosLosPrestamosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            prestamos.Clear();

            error = "Debes iniciar sesión como Administrador.";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error al consultar las solicitudes.");

            error = "No se pudieron cargar las solicitudes.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task ProcesarAsync(int prestamoId, bool aprobar)
    {
        if (ocupado)
        {
            return;
        }

        ocupado = true;
        mensaje = "";
        error = "";

        try
        {
            if (aprobar)
            {
                mensaje = await ServicioPrestamos
                    .AprobarPrestamoAsync(prestamoId);
            }
            else
            {
                mensaje = await ServicioPrestamos
                    .RechazarPrestamoAsync(prestamoId);
            }

            prestamos = await ServicioPrestamos
                .ObtenerTodosLosPrestamosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            prestamos.Clear();

            error = "Esta operación requiere el rol Administrador.";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error al procesar la solicitud {PrestamoId}.",
                prestamoId);

            error = "No se pudo completar la operación o actualizar la lista. " +
                "Pulsa Actualizar y comprueba el estado antes de reintentar.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task DevolverAsync(int prestamoId)
    {
        if (ocupado)
        {
            return;
        }

        ocupado = true;
        mensaje = "";
        error = "";

        try
        {
            mensaje = await ServicioPrestamos
                .RegistrarDevolucionAsync(prestamoId);

            prestamos = await ServicioPrestamos
                .ObtenerTodosLosPrestamosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            prestamos.Clear();

            error = "Esta operación requiere el rol Administrador.";
        }
        catch (Exception ex)
        {
            Logger.LogError(
                ex,
                "Error al devolver el préstamo {PrestamoId}.",
                prestamoId);

            error = "No se pudo completar la operación o actualizar la lista. " +
                "Pulsa Actualizar y comprueba el estado antes de reintentar.";
        }
        finally
        {
            ocupado = false;
        }
    }

    private string ClaseEstado(EstadoPrestamo estado)
    {
        return estado switch
        {
            EstadoPrestamo.Pendiente => "badge bg-warning text-dark",
            EstadoPrestamo.Aprobado => "badge bg-primary",
            EstadoPrestamo.Rechazado => "badge bg-danger",
            EstadoPrestamo.Devuelto => "badge bg-success",
            _ => "badge bg-secondary"
        };
    }
}