        "BaCcAa",
        "BaCaCa",
        "CaAaBc",
        "CaAcBa",
        "CcAaBa",
        "CaBaAc",
        "CaBcAa",
        "CcBaAa",
        "CaDaAa",
        "BbAdAa",
        "DcAaAa",
        "AaAbBd",
        "AaAdBb",
        "AbAaBd",
        "AbAdBa",
        "AdAaBb",
        "AdAbBa",
        "AaBbAd",
        "AaBdAb",
        "AbBaAd",
        "AbBdAa",
        "AdBaAb",
        "AdBbAa",
        "BdAbAa",
        "BbAaAd",
        "DaCaAa",
        "BdAaAb",
        "AcDaAa",
        "AaAbDb",
        "AbAaDb",
        "AbAbDa",
        "AaDbAb",
        "AbDaAb",
        "AbDbAa",
        "DaAbAb",
        "DbAaAb",
        "DbAbAa",
        "BaBaDa",
        "BaDaBa",
        "DaBaBa",
        "AaAaDc",
        "AaAcDa",
        "AcAaDa",
        "AaDaAc",
        "AaDcAa",
        "DaAaAc",
        "DaAcAa",
        "AaCaDa",
        "AaDaCa",
        "CaAaDa",
        "DaAaCa",
        "BaAdAb",
        "BaAbAd",
        "BaAbCb",
        "BcCaAaB"
    };

    private static bool CodigoCompatible(string codigo) =>
        !string.IsNullOrEmpty(codigo) && codigo.All(c => c >= 32 && c <= 126);

    private static string GenerarCodigoBarras(string codigo)
    {
        var valores = new List<int> { 104 };
        int checksum = 104;
        for (int i = 0; i < codigo.Length; i++)
        {
            int valor = codigo[i] - 32;
            valores.Add(valor);
            checksum = (checksum + valor * ((i + 1) % 103)) % 103;
        }
        valores.Add(checksum % 103);
        valores.Add(106);

        int ancho = 20 + valores.Sum(v => PatronesCode128[v].Sum(c => char.ToUpperInvariant(c) - 'A' + 1));
        var svg = new System.Text.StringBuilder();
        svg.Append($"<svg xmlns='http://www.w3.org/2000/svg' width='{ancho * 2}' height='56' viewBox='0 0 {ancho} 56' shape-rendering='crispEdges'>");
        svg.Append($"<rect width='{ancho}' height='56' fill='white'/>");
        int x = 10;
        foreach (int valor in valores)
        {
            foreach (char tramo in PatronesCode128[valor])
            {
                int anchoTramo = char.ToUpperInvariant(tramo) - 'A' + 1;
                if (char.IsUpper(tramo))
                    svg.Append($"<rect x='{x}' y='3' width='{anchoTramo}' height='50' fill='black'/>");
                x += anchoTramo;
            }
        }
        svg.Append("</svg>");
        return "data:image/svg+xml;base64," + Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg.ToString()));
    }


    private List<Sala> salas = new();
    private List<Sala> salasActivas = new();
    private bool asignandoSala;
    private bool guardandoSala;
    private bool asignacionExitosa;
    private string codigoAsignacion = "";
    private string salaSeleccionada = "";
    private string mensajeSala = "";

    protected override void OnInitialized()
    {
        salas = ServicioInventario.ObtenerTodasLasSalas();
        salasActivas = salas.Where(s => s.Activa).ToList();
    }

    private string NombreDeSala(int? salaId) =>
        !salaId.HasValue ? "Sin asignar" :
        salas.FirstOrDefault(s => s.Id == salaId.Value)?.Nombre ?? "Sala no encontrada";

    private void IniciarAsignacion(Herramienta herramienta)
    {
        salas = ServicioInventario.ObtenerTodasLasSalas();
        salasActivas = salas.Where(s => s.Activa).ToList();
        codigoAsignacion = herramienta.Codigo;
        salaSeleccionada = herramienta.SalaId?.ToString() ?? "";
        mensajeSala = "";
        asignandoSala = true;
        editando = false;
    }

    private async Task GuardarAsignacionAsync()
    {
        if (guardandoSala) return;
        guardandoSala = true;
        mensajeSala = "";
        try
        {
            int? salaId = string.IsNullOrWhiteSpace(salaSeleccionada)
                ? null : int.Parse(salaSeleccionada);
            asignacionExitosa = await ServicioInventario.AsignarHerramientaASalaAsync(
                codigoAsignacion, salaId);
            mensajeSala = asignacionExitosa
                ? "Asignación guardada correctamente."
                : "No se pudo asignar la herramienta. Comprueba que la sala esté activa.";
            if (asignacionExitosa)
            {
                salas = ServicioInventario.ObtenerTodasLasSalas();
                salasActivas = salas.Where(s => s.Activa).ToList();
            }
        }
        catch (UnauthorizedAccessException)
        {
            asignacionExitosa = false;
            mensajeSala = "No tienes permisos para asignar herramientas.";
        }
        catch (Exception)
        {
            asignacionExitosa = false;
            mensajeSala = "Ocurrió un error al guardar la asignación.";
        }
        finally
        {
            guardandoSala = false;
        }
    }

    private void CancelarAsignacion()
    {
        asignandoSala = false;
        codigoAsignacion = "";
        mensajeSala = "";
    }

    private string nuevoCodigo = "";
    private string nuevoNombre = "";

    private void BuscarCodigoEscaneado(string codigo)
    {
        textoBusqueda = codigo.Trim();
        filtroEstado = "Todas";
    }

    private string textoBusqueda = "";
    private string filtroEstado = "Todas";

    private string mensaje = "";
    private bool operacionExitosa = false;

    private bool editando = false;
    private string codigoEdicion = "";
    private string nombreEdicion = "";

    // Datos reales obtenidos del servicio SQLite

    private List<Herramienta> herramientas =>
        ServicioInventario.ObtenerHerramientas();

    private int totalHerramientas =>
        herramientas.Count;

    private int totalDisponibles =>
        herramientas.Count(h => h.Disponible);

    private int totalPrestadas =>
        herramientas.Count(h => !h.Disponible);

    private IEnumerable<Herramienta> herramientasFiltradas =>
        herramientas.Where(h =>
            (
                string.IsNullOrWhiteSpace(textoBusqueda) ||
                h.Codigo.Contains(
                    textoBusqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase
                ) ||
                h.Nombre.Contains(
                    textoBusqueda.Trim(),
                    StringComparison.OrdinalIgnoreCase
                )
            )
            &&
            (
                filtroEstado == "Todas" ||
                (filtroEstado == "Disponibles" && h.Disponible) ||
                (filtroEstado == "Prestadas" && !h.Disponible)
            )
        );

    private void RegistrarHerramienta()
    {
        operacionExitosa =
            ServicioInventario.RegistrarHerramienta(
                nuevoCodigo,
                nuevoNombre
            );

        if (operacionExitosa)
        {
            mensaje = "Herramienta registrada correctamente.";

            nuevoCodigo = "";
            nuevoNombre = "";
        }
        else
        {
            mensaje = "No se pudo registrar la herramienta. Verifica los campos y que el código no esté repetido.";
        }
    }

    private void IniciarEdicion(Herramienta herramienta)
    {
        codigoEdicion = herramienta.Codigo;
        nombreEdicion = herramienta.Nombre;

        editando = true;
        mensaje = "";
    }

    private void GuardarEdicion()
    {
        operacionExitosa =
            ServicioInventario.EditarHerramienta(
                codigoEdicion,
                nombreEdicion
            );

        if (operacionExitosa)
        {
            mensaje = "Herramienta actualizada correctamente.";

            editando = false;
            codigoEdicion = "";
            nombreEdicion = "";
        }
        else
        {
            mensaje = "No se pudo actualizar la herramienta. Verifica el nombre.";
        }
    }

    private void CancelarEdicion()
    {
        editando = false;
        codigoEdicion = "";
        nombreEdicion = "";
    }
