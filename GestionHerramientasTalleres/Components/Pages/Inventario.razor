        "AaBbCb",
        "AbBaCb",
        "AbBbCa",
        "AaCbBb",
        "AbCaBb",
        "AbCbBa",
        "BbCbAa",
        "BbAaCb",
        "BbAbCa",
        "BaCbAb",
        "BbCaAb",
        "CaBaCa",
        "CaAbBb",
        "CbAaBb",
        "CbAbBa",
        "CaBbAb",
        "CbBaAb",
        "CbBbAa",
        "BaBaBc",
        "BaBcBa",
        "BcBaBa",
        "AaAcBc",
        "AcAaBc",
        "AcAcBa",
        "AaBcAc",
        "AcBaAc",
        "AcBcAa",
        "BaAcAc",
        "BcAaAc",
        "BcAcAa",
        "AaBaCc",
        "AaBcCa",
        "AcBaCa",
        "AaCaBc",
        "AaCcBa",
        "AcCaBa",
        "CaCaBa",
        "BaAcCa",
        "BcAaCa",
