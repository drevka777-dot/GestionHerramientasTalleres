@page "/inventario"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@using GestionHerramientasTalleres.Components.Shared
@using GestionHerramientasTalleres.Models
@using GestionHerramientasTalleres.Services
@inject InventarioService ServicioInventario
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Inventario | Gestión de Herramientas</PageTitle>

<style>
    .inventory-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 10px 0 40px;
    }

    .inventory-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .inventory-eyebrow {
        color: #2563eb;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .inventory-title {
        font-size: clamp(27px, 3vw, 36px);
        font-weight: 800;
        color: #142d4e;
        margin-bottom: 8px;
    }

    .inventory-description {
        color: #64748b;
        margin: 0;
    }

    .inventory-heading-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        background: #dbeafe;
        color: #2563eb;
        font-size: 28px;
        flex-shrink: 0;
    }

    .inventory-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 25px;
    }

    .inventory-stat-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 22px;
        box-shadow: 0 5px 20px rgba(20, 45, 78, .045);
        position: relative;
        overflow: hidden;
    }

        .inventory-stat-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--stat-color);
        }

    .inventory-stat-label {
        color: #64748b;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 12px;
    }

    .inventory-stat-number {
        font-size: 34px;
        font-weight: 800;
        color: #142d4e;
        line-height: 1.1;
    }

    .inventory-stat-note {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 10px;
    }

    .inventory-panel {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(20, 45, 78, .045);
        margin-bottom: 24px;
        overflow: hidden;
    }

    .inventory-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 22px 26px;
        border-bottom: 1px solid #edf2f7;
        background: #fbfdff;
    }

    .inventory-panel-title {
        color: #142d4e;
        font-size: 19px;
        font-weight: 750;
        margin: 0;
    }

    .inventory-panel-subtitle {
        font-size: 13px;
        color: #64748b;
        margin: 5px 0 0;
    }

    .inventory-panel-body {
        padding: 26px;
    }

    .inventory-form-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .inventory-field-label {
        display: block;
        color: #334155;
        font-weight: 650;
        font-size: 14px;
        margin-bottom: 9px;
    }

    .inventory-input {
        width: 100%;
        min-height: 47px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        padding: 11px 14px;
        background: #fff;
        color: #1e293b;
        outline: none;
        transition: border-color .2s, box-shadow .2s;
    }

        .inventory-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
        }

        .inventory-input:disabled {
            background: #f1f5f9;
            color: #64748b;
        }

    .inventory-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: background .2s, transform .2s;
    }

    .inventory-button-primary {
        background: #2563eb;
        color: white;
    }

        .inventory-button-primary:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

    .inventory-button-success {
        background: #16a34a;
        color: white;
    }

        .inventory-button-success:hover {
            background: #15803d;
        }

    .inventory-button-neutral {
        background: #e2e8f0;
        color: #334155;
    }

        .inventory-button-neutral:hover {
            background: #cbd5e1;
        }

    .inventory-button-edit {
        padding: 8px 15px;
        background: #eff6ff;
        color: #1d4ed8;
        border: 1px solid #bfdbfe;
    }

        .inventory-button-edit:hover {
            background: #dbeafe;
        }

    .inventory-notice {
        border-radius: 10px;
        padding: 13px 16px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .inventory-notice-info {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
    }

    .inventory-notice-success {
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
    }

    .inventory-notice-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
    }

    .inventory-toolbar {
        display: grid;
        grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
        gap: 18px;
        margin-bottom: 18px;
    }

    .inventory-results {
        font-size: 13px;
        color: #64748b;
        margin-bottom: 16px;
    }

        .inventory-results strong {
            color: #1d4ed8;
        }

    .inventory-table-wrapper {
        overflow-x: auto;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

    .inventory-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .inventory-table th {
            background: #eff6ff;
            color: #334155;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 16px;
            text-align: left;
            white-space: nowrap;
        }

        .inventory-table td {
            padding: 16px;
            border-top: 1px solid #edf2f7;
            color: #334155;
            vertical-align: middle;
        }

        .inventory-table tbody tr:hover {
            background: #f8fbff;
        }

    .inventory-barcode {
        display: block;
        width: auto;
        height: 56px;
        margin-bottom: 6px;
        background: white;
    }

    .inventory-code {
        color: #1d4ed8;
        font-weight: 750;
        font-size: 13px;
    }

    .inventory-tool-name {
        color: #142d4e;
        font-weight: 650;
    }

    .inventory-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 100px;
        font-size: 12px;
        font-weight: 750;
        white-space: nowrap;
    }

        .inventory-status::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

    .inventory-status-available {
        background: #dcfce7;
        color: #15803d;
    }

    .inventory-status-loaned {
        background: #fef3c7;
        color: #92400e;
    }

    .inventory-empty {
        text-align: center;
        padding: 30px 16px;
        color: #64748b;
    }

    .inventory-room-name {
        font-size: 13px;
        color: #475569;
    }

    .inventory-room-panel {
        border: 1px solid #bfdbfe;
        background: #f8fbff;
        border-radius: 14px;
        padding: 22px;
        margin-top: 22px;
    }

    .inventory-edit-panel {
        border: 1px solid #bfdbfe;
        background: #f8fbff;
        border-radius: 14px;
        padding: 22px;
        margin-top: 22px;
    }

    .inventory-edit-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    @@media (max-width: 850px) {
        .inventory-stats {
            grid-template-columns: 1fr;
        }

        .inventory-form-grid,
        .inventory-toolbar {
            grid-template-columns: 1fr;
        }

        .inventory-panel-header,
        .inventory-panel-body {
            padding: 18px;
        }
    }
</style>

<div class="inventory-page">

    <!-- ENCABEZADO -->

    <div class="inventory-heading">
        <div>
            <div class="inventory-eyebrow">
                Administración de recursos
            </div>

            <h1 class="inventory-title">
                Inventario de herramientas
            </h1>

            <p class="inventory-description">
                Gestiona los equipos de talleres y laboratorios
                desde un solo lugar.
            </p>
        </div>

        <div class="inventory-heading-icon">
            &#128230;
        </div>
    </div>

    <!-- ESTADÍSTICAS REALES -->

    <div class="inventory-stats">

        <div class="inventory-stat-card"
             style="--stat-color: #2563eb;">
            <div class="inventory-stat-label">
                Total de herramientas
            </div>

            <div class="inventory-stat-number">
                @totalHerramientas
            </div>

            <div class="inventory-stat-note">
                Equipos registrados
            </div>
        </div>

        <div class="inventory-stat-card"
             style="--stat-color: #16a34a;">
            <div class="inventory-stat-label">
                Herramientas disponibles
            </div>

            <div class="inventory-stat-number">
                @totalDisponibles
            </div>

            <div class="inventory-stat-note">
                Listas para utilizar
            </div>
        </div>

        <div class="inventory-stat-card"
             style="--stat-color: #f59e0b;">
            <div class="inventory-stat-label">
                Herramientas prestadas
            </div>

            <div class="inventory-stat-number">
                @totalPrestadas
            </div>

            <div class="inventory-stat-note">
                Actualmente no disponibles
            </div>
        </div>

    </div>

    <!-- REGISTRO -->

    <section class="inventory-panel">

        <div class="inventory-panel-header">
            <div>
                <h2 class="inventory-panel-title">
                    Registrar nueva herramienta
                </h2>

                <p class="inventory-panel-subtitle">
                    Agrega un nuevo equipo al inventario.
                </p>
            </div>
        </div>

        <div class="inventory-panel-body">

            <div class="inventory-notice inventory-notice-info">
                Sistema de demostración académica.
                Los registros se almacenan en SQLite.
            </div>

            <div class="inventory-form-grid">

                <div>
                    <label class="inventory-field-label"
                           for="nuevoCodigo">
                        Código de herramienta
                    </label>

                    <input id="nuevoCodigo"
                           class="inventory-input"
                           @bind="nuevoCodigo"
                           placeholder="Ejemplo: HER-005" />
                </div>

                <div>
                    <label class="inventory-field-label"
                           for="nuevoNombre">
                        Nombre de la herramienta
                    </label>

                    <input id="nuevoNombre"
                           class="inventory-input"
                           @bind="nuevoNombre"
                           placeholder="Ejemplo: Llave inglesa" />
                </div>

            </div>

            <button type="button"
                    class="inventory-button inventory-button-primary"
                    @onclick="RegistrarHerramienta">
                + Registrar herramienta
            </button>

            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="inventory-notice @(operacionExitosa ? "inventory-notice-success" : "inventory-notice-error")"
                     style="margin-top: 18px; margin-bottom: 0;"
                     role="status">
                    @mensaje
                </div>
            }

        </div>

    </section>

    <!-- LISTADO -->

    <section class="inventory-panel">

        <div class="inventory-panel-header">
            <div>
                <h2 class="inventory-panel-title">
                    Herramientas registradas
                </h2>

                <p class="inventory-panel-subtitle">
                    Consulta, busca y administra tus herramientas.
                </p>
            </div>
        </div>

        <div class="inventory-panel-body">

            <EscanerHerramientas OnCodigoDetectado="BuscarCodigoEscaneado" />

            <div class="inventory-toolbar">

                <div>
                    <label class="inventory-field-label"
                           for="buscarHerramienta">
                        Buscar herramienta
                    </label>

                    <input id="buscarHerramienta"
                           class="inventory-input"
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           placeholder="Buscar por código o nombre..." />
                </div>

                <div>
                    <label class="inventory-field-label"
                           for="filtrarEstado">
                        Estado de herramienta
                    </label>

                    <select id="filtrarEstado"
                            class="inventory-input"
                            @bind="filtroEstado">

                        <option value="Todas">
                            Todas las herramientas
                        </option>

                        <option value="Disponibles">
                            Disponibles
                        </option>

                        <option value="Prestadas">
                            Prestadas
                        </option>

                    </select>
                </div>

            </div>

            <div class="inventory-results">
                Mostrando
                <strong>@herramientasFiltradas.Count()</strong>
                de
                <strong>@totalHerramientas</strong>
                herramientas
            </div>

            <div class="inventory-table-wrapper">

                <table class="inventory-table">

                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Herramienta</th>
                            <th>Estado</th>
                            <th>Sala asignada</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var herramienta in herramientasFiltradas)
                        {
                            <tr>

                                <td>
                                    @if (CodigoCompatible(herramienta.Codigo))
                                    {
                                        <img class="inventory-barcode"
                                             src="@GenerarCodigoBarras(herramienta.Codigo)"
                                             alt="Código de barras de @herramienta.Codigo" />
                                    }
                                    else
                                    {
                                        <small class="text-muted d-block">Código no compatible con Code 128 B</small>
                                    }
                                    <span class="inventory-code">
                                        @herramienta.Codigo
                                    </span>
                                </td>

                                <td>
                                    <span class="inventory-tool-name">
                                        @herramienta.Nombre
                                    </span>
                                </td>

                                <td>
                                    @if (herramienta.Disponible)
                                    {
                                        <span class="inventory-status inventory-status-available">
                                            Disponible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inventory-status inventory-status-loaned">
                                            Prestado
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="inventory-room-name">@NombreDeSala(herramienta.SalaId)</span>
                                </td>

                                <td>
                                    <button type="button"
                                            class="inventory-button inventory-button-edit"
                                            @onclick="() => IniciarEdicion(herramienta)">
                                        Editar
                                    </button>
                                    <AuthorizeView Roles="Administrador">
                                        <button type="button"
                                                class="inventory-button inventory-button-edit"
                                                style="margin-left: 8px;"
                                                @onclick="() => IniciarAsignacion(herramienta)">
                                            Asignar sala
                                        </button>
                                    </AuthorizeView>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (!herramientasFiltradas.Any())
            {
                <div class="inventory-empty">
                    No se encontraron herramientas
                    con los filtros seleccionados.
                </div>
            }

            <!-- ASIGNACIÓN DE SALA (SOLO ADMINISTRADOR) -->
            <AuthorizeView Roles="Administrador">
                @if (asignandoSala)
                {
                    <div class="inventory-room-panel">
                        <h3 class="inventory-panel-title">Asignar herramienta a una sala</h3>
                        <p class="inventory-panel-subtitle" style="margin-bottom: 20px;">
                            Herramienta: @codigoAsignacion
                        </p>
                        <label class="inventory-field-label" for="salaAsignacion">Sala de destino</label>
                        <select id="salaAsignacion" class="inventory-input" @bind="salaSeleccionada">
                            <option value="">Sin asignar</option>
                            @foreach (var sala in salasActivas)
                            {
                                <option value="@sala.Id">@sala.Nombre (@sala.Ubicacion)</option>
                            }
                        </select>
                        <div class="inventory-edit-actions">
                            <button type="button"
                                    class="inventory-button inventory-button-success"
                                    disabled="@guardandoSala"
                                    @onclick="GuardarAsignacionAsync">
                                @(guardandoSala ? "Guardando..." : "Guardar asignación")
                            </button>
                            <button type="button"
                                    class="inventory-button inventory-button-neutral"
                                    disabled="@guardandoSala"
                                    @onclick="CancelarAsignacion">
                                Cancelar
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(mensajeSala))
                        {
                            <div class="inventory-notice @(asignacionExitosa ? "inventory-notice-success" : "inventory-notice-error")"
                                 style="margin-top: 16px; margin-bottom: 0;" role="status">
                                @mensajeSala
                            </div>
                        }
                    </div>
                }
            </AuthorizeView>

            <!-- EDICIÓN -->
            @if (editando)
            {
                <div class="inventory-edit-panel">

                    <h3 class="inventory-panel-title">
                        Editar herramienta
                    </h3>

                    <p class="inventory-panel-subtitle"
                       style="margin-bottom: 20px;">
                        Modifica el nombre de la herramienta seleccionada.
                    </p>

                    <div class="inventory-form-grid">

                        <div>
                            <label class="inventory-field-label"
                                   for="codigoEdicion">
                                Código
                            </label>

                            <input id="codigoEdicion"
                                   class="inventory-input"
                                   value="@codigoEdicion"
                                   disabled />
                        </div>

                        <div>
                            <label class="inventory-field-label"
                                   for="nombreEdicion">
                                Nombre de herramienta
                            </label>

                            <input id="nombreEdicion"
                                   class="inventory-input"
                                   @bind="nombreEdicion"
                                   placeholder="Nuevo nombre" />
                        </div>

                    </div>

                    <div class="inventory-edit-actions">

                        <button type="button"
                                class="inventory-button inventory-button-success"
                                @onclick="GuardarEdicion">
                            Guardar cambios
                        </button>

                        <button type="button"
                                class="inventory-button inventory-button-neutral"
                                @onclick="CancelarEdicion">
                            Cancelar
                        </button>

                    </div>

                </div>
            }

        </div>

    </section>

</div>

@code {

    // Code 128 B: ASCII imprimible, checksum módulo 103 y zonas de silencio.
    private static readonly string[] PatronesCode128 = new string[]
    {
        "BaBbBb",
        "BbBaBb",
        "BbBbBa",
        "AbAbBc",
        "AbAcBb",
        "AcAbBb",
        "AbBbAc",
