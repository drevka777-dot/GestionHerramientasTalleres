@using Microsoft.AspNetCore.Components.Authorization

<div class="modern-sidebar-header">
    <a class="modern-sidebar-brand" href="">
        <span class="modern-brand-icon">
            &#9881;
        </span>

        <span class="modern-brand-text">
            <strong>Gestión de Herramientas</strong>
            <small>Talleres y Laboratorios · UCC</small>
        </span>
    </a>
</div>

<input type="checkbox"
       title="Abrir o cerrar menú"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="modern-sidebar-nav">

        <div class="modern-nav-heading">
            MENÚ PRINCIPAL
        </div>

        <div class="modern-nav-item">
            <NavLink class="modern-nav-link"
                     href=""
                     Match="NavLinkMatch.All">

                <span class="modern-nav-icon">
                    &#8962;
                </span>

                <span>Inicio</span>
            </NavLink>
        </div>

        <div class="modern-nav-item">
            <NavLink class="modern-nav-link"
                     href="inventario">

                <span class="modern-nav-icon">
                    &#9638;
                </span>

                <span>Inventario</span>
            </NavLink>
        </div>

        @* Opciones para usuarios. *@
        <AuthorizeView Roles="Usuario">
            <Authorized>
                <div class="modern-nav-item">
                    <NavLink class="modern-nav-link"
                             href="prestamos">

                        <span class="modern-nav-icon">
                            &#8644;
                        </span>

                        <span>Préstamos</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        @* Opciones para administradores. *@
        <AuthorizeView Roles="Administrador">
            <Authorized>

                <div class="modern-nav-item">
                    <NavLink class="modern-nav-link"
                             href="administrar-prestamos">

                        <span class="modern-nav-icon">
                            &#8644;
                        </span>

                        <span>Administrar préstamos</span>
                    </NavLink>
                </div>

                <div class="modern-nav-item">
                    <NavLink class="modern-nav-link"
                             href="control-salas">

                        <span class="modern-nav-icon">
                            &#9635;
                        </span>

                        <span>Control de salas</span>
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>

        <div class="modern-nav-divider"></div>

        <div class="modern-sidebar-note">
            Sistema de gestión académica
        </div>

    </nav>
</div>