@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using GestionHerramientasTalleres.Models
@using System.Security.Claims

@inject UserManager<UsuarioSistema> UserManager

<AuthorizeView>
    <Authorized Context="sesion">

        <div class="perfil-contenedor">

            <div class="perfil-avatar">
                👤
            </div>

            <div class="perfil-informacion">
                <span class="perfil-nombre">
                    @nombreCompleto
                </span>

                <span class="perfil-rol">
                    @(sesion.User.IsInRole("Administrador")
                        ? "Administrador"
                        : "Usuario")
                </span>
            </div>

            <form action="/logout" method="post">
                <AntiforgeryToken />

                <button type="submit"
                        class="perfil-salir">
                    Cerrar sesión
                </button>
            </form>

        </div>

    </Authorized>

    <NotAuthorized>

        <div class="perfil-contenedor">

            <a href="/login" class="perfil-enlace">
                Iniciar sesión
            </a>

            <a href="/registro" class="perfil-registro">
                Crear cuenta
            </a>

        </div>

    </NotAuthorized>
</AuthorizeView>

<style>
    .perfil-contenedor {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 14px;
        width: 100%;
    }

    .perfil-avatar {
        width: 39px;
        height: 39px;
        border-radius: 50%;
        background: #eaf2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .perfil-informacion {
        display: flex;
        flex-direction: column;
        line-height: 1.3;
    }

    .perfil-nombre {
        font-weight: 700;
        font-size: 13px;
        color: #102744;
    }

    .perfil-rol {
        font-size: 12px;
        color: #64748b;
    }

    .perfil-salir {
        background: #fee2e2;
        color: #b91c1c;
        padding: 9px 13px;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .perfil-salir:hover {
            background: #fecaca;
            color: #991b1b;
        }

    .perfil-enlace {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
    }

    .perfil-registro {
        background: #2563eb;
        color: white;
        padding: 9px 13px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

        .perfil-registro:hover {
            background: #1d4ed8;
            color: white;
        }
</style>

@code {
    private string nombreCompleto = "Usuario";

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask
    {
        get;
        set;
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var estado = await AuthenticationStateTask;
        var usuario = estado.User;

        if (usuario.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var nombreUsuario = usuario.Identity.Name;

        if (!string.IsNullOrWhiteSpace(nombreUsuario))
        {
            nombreCompleto = nombreUsuario;
        }

        // Recuperar el nombre completo desde Identity.
        var usuarioSistema = await UserManager.GetUserAsync(usuario);

        if (usuarioSistema is not null &&
            !string.IsNullOrWhiteSpace(usuarioSistema.NombreCompleto))
        {
            nombreCompleto = usuarioSistema.NombreCompleto;
        }
    }
}
